;コマンド実行時に出力されます
;--------------------------------------------------
@KOJO_MESSAGE_COM_9
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
SIF ASSI > 0 && ASSIPLAY
	RETURN 0 
;口塞着用時には口上をスキップする
SIF TEQUIP:45 && SELECTCOM != 45
	RETURN 0
;失神時には口上をスキップする
SIF TFLAG:899
	RETURN 0
;兽奸PLAY中は専用口上
IF TEQUIP:89
	CALL DOG_KOJO_9
	RETURN 0
ENDIF
;死斗场中は専用口上
IF TEQUIP:55
	CALL COLOSSEUM_KOJO_9
	RETURN 0
ENDIF
;崩坏した場合は口上をスキップする
SIF TALENT:TARGET:9 == 1
	RETURN 0
;触手調教中は口上をスキップする
SIF TEQUIP:90
	RETURN 0

;-------------------------------------------------
;コマンド実行時のセリフ CFLAG 301～400を使用
;-------------------------------------------------
;-------------------------------------------------
;爱撫 CFLAG:301
;-------------------------------------------------
IF SELECTCOM == 0
	;初めて
	IF CFLAG:301 == 0
		;屈服刻印Lv2以上
		IF MARK:2 >= 2
			PRINTFORMW 「真的…哼，这样的话我只要忍耐就…啊…啊啊啊！那样的地方不要碰啊！」
		;それ以外
		ELSE
			PRINTFORMW 「你这个变态…下流的手在摸哪里啊…啊…啊啊啊！」
		ENDIF
		CFLAG:301 = 1
		RETURN 0
	;二回目以降
	ELSE
		;淫乱
		IF TALENT:TARGET:76 == 1 && (CFLAG:301 <= 5 || FLAG:7 == 2)
			PRINTFORMW 「哼…光是那样的话还不够哟……要进到肉壶里面才可以…对…这里…啊啊%UNICODE(0x2661) *1%」
			PRINTFORMW %SAVESTR:TARGET%的腰不停的晃动起来，追求更多的快感。
			PRINTFORMW 「这样…好…好东西…那里…还要%UNICODE(0x2661) *1%」
			CFLAG:301 = 6
		;爱慕
		ELSEIF TALENT:TARGET:85 == 1 && (CFLAG:301 <= 4 || FLAG:7 == 2)
			PRINTFORMW 「还要…请您摸%UNICODE(0x2661) *1%…啊啊…是的…这…喜欢…啊啊啊%UNICODE(0x2661) *1%」
			PRINTFORMW %SAVESTR:TARGET%喜欢被%SAVESTR:PLAYER%爱抚的感觉。身体摆成更容易抚摸到的姿势。
			PRINTFORMW 「好高兴…啊啊…喜欢…喜欢的…你啊…%UNICODE(0x2661) *1%」
			CFLAG:301 = 5
		;屈服刻印Lv3
		ELSEIF MARK:2 == 3 && (CFLAG:301 <= 3 || FLAG:7 == 2)
			PRINTFORMW 「摸吧、没关系…这样做…稍微感觉到有些舒服…啊，真是的…被你的手这样的抚摸…被你摸到高潮了…啊啊啊♪」
			PRINTFORMW %SAVESTR:TARGET%抱着%SAVESTR:PLAYER%的胳膊，沉浸在快感中，小声的喘息着………
			CFLAG:301 = 4
		;屈服刻印Lv2
		ELSEIF MARK:2 == 2 && (CFLAG:301 <= 2 || FLAG:7 == 2)
			PRINTFORMW 「不用…不用在意…啊啊啊！只要忍耐着就当没感觉到就行了…一定能行的！」
			PRINTFORMW %SAVESTR:TARGET%被%SAVESTR:PLAYER%爱抚着，身体不断的扭动………
			CFLAG:301 = 3
		;それ以外
		ELSEIF MARK:2 <= 1 && (CFLAG:301 <= 1 || FLAG:7 == 2)
			PRINTFORMW 「哼、对我做这种事情…是没有任何感觉的…前面全是白费力气…呀、又开始摸了！」
			CFLAG:301 = 2
		ENDIF
		RETURN 0
	ENDIF
ENDIF

;-------------------------------------------------
;舔阴 CFLAG:302
;-------------------------------------------------
IF SELECTCOM == 1
	;初めて
	IF CFLAG:302 == 0
		;处女
		IF TALENT:TARGET:0 == 1
			PRINTFORMW 「啊、不行…不要把嘴放到那种地方…你、有没有听我在说什么！」
			PRINTFORMW %SAVESTR:PLAYER%品尝着%SAVESTR:TARGET%下体处女的味道、%SAVESTR:TARGET%涨红着脸，拼命的摇着头………
		;それ以外
		ELSE
			PRINTFORMW 「啊啊啊…没有，不…不明白…为什么把嘴放到那种地方…啊啊啊啊！」
		ENDIF
		CFLAG:302 = 1
		RETURN 0
	;二回目以降
	ELSE
		;淫乱
		IF TALENT:TARGET:76 == 1 && (CFLAG:302 <= 4 || FLAG:7 == 2)
			PRINTFORMW 「还要…更多%UNICODE(0x2661) *1% 继续舔我这淫乱的淫穴%UNICODE(0x2661) *1%」
			PRINTFORMW %SAVESTR:TARGET%的阴唇被持续的吸舔，高声的叫喊着、双手紧抱着%SAVESTR:PLAYER%的头向自己的双腿间压着。
			PRINTFORMW 「嗯！好！好的！就这样…吃我的淫穴吧…好舒服…脑袋一片空白了%UNICODE(0x2661) *1%」
			CFLAG:302 = 5
		;爱慕
		ELSEIF TALENT:TARGET:85 == 1 && (CFLAG:302 <= 3 || FLAG:7 == 2)
			PRINTFORMW 「那么热情的舔着…啊啊啊…是的…更…更多！%UNICODE(0x2661) *1%」
			PRINTFORMW %SAVESTR:TARGET%的阴唇被持续的吸舔，娇声的呼喊着、双腿大张着，让%SAVESTR:PLAYER%的头能更加深入。
			PRINTFORMW 「啊啊啊…好喜欢…好喜欢啊…这种被舔的感觉简直太好了%UNICODE(0x2661) *1%」
			CFLAG:302 = 4
		;屈服刻印Lv3
		ELSEIF MARK:2 == 3 && (CFLAG:302 <= 2 || FLAG:7 == 2)
			PRINTFORMW 「啊啊…这样…啊啊…竟然…舌头伸到里面去了…里面…感觉到了！」
			PRINTFORMW %SAVESTR:TARGET%的阴唇被舔着，不禁皱起了眉头、忍不住的快感随着声音漏了出来…
			CFLAG:302 = 3
		;それ以外（屈服刻印Lv3未満）
		ELSEIF CFLAG:302 <= 1 || FLAG:7 == 2
			PRINTFORMW 「呼，哼…居然像狗一样的那样舔…像傻瓜似的…啊…再这么做去当狗好了吧！」
			PRINTFORMW %SAVESTR:TARGET%露出厌恶表情的同时情不自禁的抬起了腰，好让蜜穴更容易的被舔到、声音中露出了快感…
			CFLAG:302 = 2
		ENDIF
		RETURN 0
	ENDIF
ENDIF

;-------------------------------------------------
;アナル爱撫 CFLAG:303
;-------------------------------------------------
IF SELECTCOM == 2
	;初めて
	IF CFLAG:303 == 0
		IF ABL:3 >= 3
			PRINTFORMW 「啊啊…什么…奥…进来了…啊啊…发生了什么♪」
			PRINTFORMW %SAVESTR:TARGET%没被开发过的肛门对%SAVESTR:PLAYER%的爱抚非常敏感………
		ELSE
			PRINTFORMW 「这样、这样的事情！很脏的…里面很脏！讨厌啊啊！」
			PRINTFORMW %SAVESTR:TARGET%发出了悲鸣。%SAVESTR:PLAYER%的手指毫不留情的插入了没有准备的肛门………
		ENDIF
		CFLAG:TARGET:303 = 1
		RETURN 0
	;二回目以降
	ELSE
		P = PALAM:3 + UP:3
		;淫乱+アナル狂い+润滑Lv2以上
		IF TALENT:TARGET:76 == 1 && TALENT:TARGET:77 == 1 && P >= PALAMLV:2 && (CFLAG:303 <= 8 || FLAG:7 == 2)
			PRINTFORMW 「进来了…好舒服…%UNICODE(0x2661) *1% 要、要更多…我的屁眼…好奇怪的感觉啊啊%UNICODE(0x2661) *1%」
			PRINTFORMW %SAVESTR:TARGET%娇声呼喊着、肛门不停的收缩、身体颤抖着。
			PRINTFORMW 「啊呀…啊呀呀呀%UNICODE(0x2661) *1% 只是屁眼…就有这种感觉，啊啊%UNICODE(0x2661) *1%」
			CFLAG:303 = 9
		;淫乱+润滑Lv2以上
		ELSEIF TALENT:TARGET:76 == 1 && P >= PALAMLV:2 && (CFLAG:303 <= 6 || FLAG:7 == 2)
			PRINTFORMW 「啊…那里…不能再进去了…啊啊啊…肛门都张开啊…啊啊啊%UNICODE(0x2661) *1%」
			PRINTFORMW %SAVESTR:TARGET%的肛门被爱抚的逐渐张开了，嘴里发出快乐的叹息。
			PRINTFORMW 「哈…哈…不是这样的…啊啊啊…想要%SAVESTR:PLAYER%的肉棒，想要更粗的东西%UNICODE(0x2661) *1%」
			CFLAG:303 = 8
		;淫乱+润滑Lv2未満
		ELSEIF TALENT:TARGET:76 == 1 && P < PALAMLV:2 && (CFLAG:303 <= 5 || FLAG:7 == 2)
			PRINTFORMW 「哼…不行！不是那样的…还没有被弄湿…呵呵，着急了吗♡。%UNICODE(0x2661) *1%」
			PRINTFORMW %SAVESTR:TARGET%说润滑还不够的………
			CFLAG:303 = 7
		;アナル狂い+润滑Lv2以上
		ELSEIF TALENT:TARGET:77 == 1 && P >= PALAMLV:2 && (CFLAG:303 <= 5 || FLAG:7 == 2)
			PRINTFORMW 「进来了…好舒服…%UNICODE(0x2661) *1% 也，也…不行了…这，就是这样…啊啊啊啊啊%UNICODE(0x2661) *1%」
			PRINTFORMW %SAVESTR:TARGET%娇声呼喊着、肛门不停的收缩、身体颤抖着。
			PRINTFORMW 「啊呀…啊呀呀呀%UNICODE(0x2661) *1% 只是屁眼…就有这种感觉，啊啊%UNICODE(0x2661) *1%」
			CFLAG:303 = 6
		;爱慕+润滑Lv2以上
		ELSEIF TALENT:TARGET:85 == 1 && P >= PALAMLV:2 && (CFLAG:303 <= 4 || FLAG:7 == 2)
			PRINTFORMW 「啊啊…啊啊啊…请、请您检查我的屁股…啊、啊啊%UNICODE(0x2661) *1%啊哈，啊哈%UNICODE(0x2661) *1%」
			PRINTFORMW %SAVESTR:TARGET%因为屁股被爱抚，轻声娇喘着。
			PRINTFORMW 「啊啊啊…请原谅我…被玩弄屁股也会这个样子…啊啊…好难为情啊…太奇怪了%UNICODE(0x2661) *1%」
			CFLAG:303 = 5
		;爱慕+润滑Lv2未満
		ELSEIF TALENT:TARGET:85 == 1 && P < PALAMLV:2 && (CFLAG:303 <= 3 || FLAG:7 == 2)
			PRINTFORMW 「进来了…啊，不过，还是有点干…抱歉…啊，辛苦了…哼！」
			PRINTFORMW %SAVESTR:TARGET%说润滑还不够的……
			CFLAG:303 = 4
		;润滑Lv2以上＋A感覚Lv3以上
		ELSEIF P >= PALAMLV:2 && ABL:3 >= 3 && (CFLAG:303 <= 2 || FLAG:7 == 2)
			PRINTFORMW 「哎！？…会、是什么样的感觉…说不清楚…舒服…稍微有一点！」
			PRINTFORMW %SAVESTR:TARGET%被开发的肛门不断受到刺激，笨拙的蠕动着、产生出了一些快感………
			PRINTFORMW 「这，这个样子…是不行的许…因为…啊啊啊♪」
			CFLAG:303 = 3
		;それ以外（爱無し、润滑Lv2未満、A感覚Lv3未満）
		ELSEIF CFLAG:223 <= 1 || FLAG:7 == 2
			PRINTFORMW 「啊！不啊！这样的…不行！啊啊！」
			PRINTFORMW %SAVESTR:TARGET%发出悲鸣识图逃跑，但因为身体被紧紧压住，只能撅着屁股被来回的玩弄………
			CFLAG:303 = 2
		ENDIF
		RETURN 0
	ENDIF
ENDIF

;-------------------------------------------------
