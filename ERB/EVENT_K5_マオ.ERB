	ENDIF
	RETURN 1
;淫乱(体力500未満)
ELSEIF TALENT:TARGET:76 == 1 && BASE:0 <= 500
	DRAWLINE
	;魔族
	IF TALENT:TARGET:314 == 9
		PRINTFORMW 「啊…還要…還想要…請把我幹死吧…%UNICODE(0x2661) *1%」
