ELSEIF TALENT:TARGET:85 == 1 && BASE:0 >= 500
	DRAWLINE
	;魔族（仮2012/5/19）
	IF TALENT:TARGET:314 == 9
		PRINTFORMW 「魔王大人還滿意嗎…？」
		PRINTFORMW %SAVESTR:TARGET%在床上手忙脚亂的。體力還很富餘的樣子………
	;それ以外
	ELSE
		PRINTFORMW 「魔王大人還滿意嗎…？」
		PRINTFORMW %SAVESTR:TARGET%體力還很富餘的樣子………
	ENDIF
	RETURN 1
;愛慕(体力500未満)
ELSEIF TALENT:TARGET:85 == 1 && BASE:0 <= 500
	DRAWLINE
	;魔族（仮2012/5/19）
	IF TALENT:TARGET:314 == 9
		PRINTFORMW 「很高興能好好地侍奉魔王大人喲…%UNICODE(0x2661) *1%」
		PRINTFORMW %SAVESTR:TARGET%露出了滿足的笑容………
	;それ以外
	ELSE
		PRINTFORMW 「對我這樣的孩子做出這樣的事…主人還真是個變態呢%UNICODE(0x2661) *1%」
		PRINTFORMW %SAVESTR:TARGET%露出了滿足的笑容………
	ENDIF
	RETURN 1
