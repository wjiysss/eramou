	ELSEIF ABL:4 == 2
		;Ｆ感覚2
		IF CSTR:7 == "嗅觉"
			PRINTFORML %SAVESTR:TARGET%虽然很讨厌这样、但对味道十分的中意…
		ELSE
			PRINTFORML %SAVESTR:TARGET%虽然对%CSTR:7%并不感冒、但对那样的感觉十分中意…
		ENDIF
	ELSEIF ABL:4 == 1
		;Ｆ感覚1
		IF CSTR:7 == "嗅觉"
			PRINTFORML %SAVESTR:TARGET%虽然很讨厌这样、但对味道开始有了感觉…
		ELSE
			PRINTFORML %SAVESTR:TARGET%虽然对%CSTR:7%调教十分厌恶、但开始有了感觉…
		ENDIF
	ELSE
		IF CSTR:7 == "嗅觉"
			PRINTFORML %SAVESTR:TARGET%对嗅觉调教十分厌恶…
		ELSE
			PRINTFORML %SAVESTR:TARGET%对%CSTR:7%调教十分厌恶…
		ENDIF
	ENDIF
	
ENDIF

RETURN 0
