@COM108
;触手口辱
PRINTL 触手口辱
;SAVESTR:22 = 触手口辱
CALL TRAIN_MESSAGE_B

LOSEBASE:0 += 80
LOSEBASE:1 += 100

;初吻
IF CFLAG:16 == -1
	CFLAG:16 = 999
	TFLAG:13 = 1
ENDIF

;ABL:侍奉精神をみる
IF ABL:16 == 0
	SOURCE:4 += 200
	 A = 100
ELSEIF ABL:16 == 1
	SOURCE:4 += 300
	A = 200
ELSEIF ABL:16 == 2
	SOURCE:4 += 400
	A = 400
ELSEIF ABL:16 == 3
	SOURCE:4 += 500
	A = 600
ELSEIF ABL:16 == 4
	SOURCE:4 += 600
	A = 800
ELSE
	SOURCE:4 += 800
	A = 1100
ENDIF

;ABL:技巧をみる
IF ABL:12 == 0
	TIMES SOURCE:4 , 0.50
ELSEIF ABL:12 == 1
	TIMES SOURCE:4 , 0.80
ELSEIF ABL:12 == 2
	TIMES SOURCE:4 , 1.00
ELSEIF ABL:12 == 3
	TIMES SOURCE:4 , 1.20
ELSEIF ABL:12 == 4
	TIMES SOURCE:4 , 1.50
ELSE
	TIMES SOURCE:4 , 2.00
ENDIF

SOURCE:13 += A
SOURCE:16 += A

;触手の抜き挿し
IF TEQUIP:98
	TEQUIP:98 = 0
ELSE
	TEQUIP:98 = 1
	STAIN:0 |= 2
	STAIN:0 |= 4
ENDIF
T = 0

EXP:22 += 1
PRINTL 口交经验＋１
RETURN 1


