;冷漠
IF TALENT:21
	TIMES A , 1.10
	TIMES B , 1.10
	TIMES C , 1.10
	TIMES D , 1.10
	TIMES E , 1.10
ENDIF
;感情淡薄
IF TALENT:22
	TIMES A , 1.50
	TIMES B , 1.50
	TIMES C , 1.50
	TIMES D , 1.50
	TIMES E , 1.50
ENDIF
;保守的
IF TALENT:24
	TIMES A , 1.20
	TIMES B , 1.20
	TIMES C , 1.20
	TIMES D , 1.20
	TIMES E , 1.20
ENDIF
;悲观的
IF TALENT:26
	TIMES A , 0.90
	TIMES B , 0.90
	TIMES C , 0.90
	TIMES D , 0.90
	TIMES E , 0.90
ENDIF

;看重贞操
IF TALENT:30
	TIMES A , 1.20
	TIMES B , 1.20
	TIMES C , 1.20
	TIMES D , 1.20
	TIMES E , 1.20
;看轻贞操
ELSEIF TALENT:31
	TIMES A , 0.90
	TIMES B , 0.90
	TIMES C , 0.90
	TIMES D , 0.90
	TIMES E , 0.90
ENDIF

;压抑
IF TALENT:32
	TIMES A , 1.20
	TIMES B , 1.20
	TIMES C , 1.20
	TIMES D , 1.20
	TIMES E , 1.20
;开放
ELSEIF TALENT:33
	TIMES A , 0.60
	TIMES B , 0.60
	TIMES C , 0.60
	TIMES D , 0.60
	TIMES E , 0.60
ENDIF

;抵抗
IF TALENT:34
	TIMES A , 2.00
	TIMES B , 2.00
	TIMES C , 2.00
	TIMES D , 2.00
	TIMES E , 2.00
ENDIF

;害羞
IF TALENT:35
	TIMES A , 0.90
	TIMES B , 0.90
	TIMES C , 0.90
	TIMES D , 0.90
	TIMES E , 0.90
;不知羞耻
ELSEIF TALENT:36
	TIMES A , 1.20
	TIMES B , 1.20
	TIMES C , 1.20
	TIMES D , 1.20
	TIMES E , 1.20
ENDIF

;害怕疼痛
IF TALENT:40
	TIMES A , 1.10
	TIMES B , 1.10
	TIMES C , 1.10
	TIMES D , 1.10
	TIMES E , 1.10
;不惧疼痛
ELSEIF TALENT:41
	TIMES A , 0.95
	TIMES B , 0.95
	TIMES C , 0.95
	TIMES D , 0.95
	TIMES E , 0.95
ENDIF

;接受快感
IF TALENT:70
	TIMES A , 0.90
	TIMES B , 0.90
	TIMES C , 0.90
	TIMES D , 0.90
	TIMES E , 0.90
;否定快感
ELSEIF TALENT:71
	TIMES A , 1.10
	TIMES B , 1.10
	TIMES C , 1.10
	TIMES D , 1.10
	TIMES E , 1.10
ENDIF

;淫乱
IF TALENT:76
	TIMES A , 0.80
	TIMES B , 0.80
	TIMES C , 0.80
	TIMES D , 0.80
	TIMES E , 0.80
ENDIF
;倒錯的
IF TALENT:80
	TIMES A , 0.75
	TIMES B , 0.75
	TIMES C , 0.75
	TIMES D , 0.75
	TIMES E , 0.75
ENDIF
;施虐狂
IF TALENT:83
	TIMES A , 1.20
	TIMES B , 1.20
	TIMES C , 1.20
	TIMES D , 1.20
	TIMES E , 1.20
ENDIF
;受虐狂
IF TALENT:88
	TIMES A , 0.50
	TIMES B , 0.50
	TIMES C , 0.50
	TIMES D , 0.50
	TIMES E , 0.50
ENDIF
;疯狂
IF TALENT:123
	TIMES A , 0.80
	TIMES B , 0.80
	TIMES C , 0.80
	TIMES D , 0.80
	TIMES E , 0.80
ENDIF
;崩坏
IF TALENT:9
	TIMES A , 2.00
	TIMES B , 2.00
	TIMES C , 2.00
	TIMES D , 2.00
	TIMES E , 2.00
ENDIF

;欲望が抖M气质＋１レベルでないといけない
IF ABL:11 < ABL:21+1
	;欲望が不足
	I |= 4
	J |= 4
ENDIF

;异常经验が不足
IF EXP:50 < F
	I |= 2
	J |= 2
ENDIF

;欲情＋苦痛点数で上げる場合
IF B > 0
	;苦痛点数が不足
	SIF JUEL:9 < A
		I |= 1
	;欲情点数が不足
	SIF JUEL:5 < B
		I |= 1
	;被虐快乐经验が不足
	SIF EXP:30 < C
		I |= 2
ELSE
	I = 256
ENDIF

;苦痛＋屈服点数で上げる
IF D > 0
	;苦痛点数が不足
	SIF JUEL:9 < D
		J |= 1
	;屈服点数が不足
	SIF JUEL:6 < E
		J |= 1
	;被虐快乐经验が不足
	SIF EXP:30 < C
		J |= 2
	;绝顶经验が不足
	SIF EXP:2 < G
		J |= 2
ELSE
	J = 256
ENDIF

IF I == 0 || J == 0
	RETURN 1
ELSE
	RETURN 0
ENDIF

