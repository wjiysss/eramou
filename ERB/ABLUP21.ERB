;受虐狂ッ気のLvUP処理とその可否判定
;eratohoA ver1,204のスクリプトをベースに処理を簡略化
;eraIM@Sから導入しました(eramaou)

;-------------------------------------------------
;受虐狂ッ気のLvUP
;-------------------------------------------------
@ABLUP21
DRAWLINE
;PRINTL 奴隶的M气质提升了。
;PRINTL M气质越高，越容易在痛苦和屈辱的行为中获得快感。
;CUSTOMDRAWLINE ‥
;受虐狂ッ気はLv5が上限
;[胆怯][文静][把柄][受虐狂]が付いている場合はLv10まで开放
IF ABL:21 >= 5 && (TALENT:10 == 0 && TALENT:14 == 0 && TALENT:37 == 0 && TALENT:88 == 0)
	PRINTW 需要特殊素质才能继续提升
	RETURN 0
;抖S气质＋抖M气质は21以上にならない
ELSEIF ABL:20 + ABL:21 >= 20
	PRINTFORMW 抖S气质({ABL:20})＋抖M气质({ABL:21})上限为20
	RETURN 0
ELSEIF ABL:21 >= 10
	PRINTW 已达最高级
	RETURN 0
ENDIF

;苦痛＋欲情で上げる場合に必要な苦痛点数
A = 0
;必要な欲情点数
B = 0
;必要な被虐快乐经验回数
C = 0
;苦痛＋屈服で上げる場合に必要な苦痛点数
D = 0
;必要な屈服点数
E = 0
;必要な异常经验回数
F = 0
;必要な绝顶经验回数
G = 0

;条件別にＯＫかダメかを記録する
;苦痛＋欲情点数による可否（I=0:可、I&1:点数不足、I&2:経験不足、I&4:能力不足）
I = 0
;苦痛＋屈服点数による可否（I=0:可、I&1:点数不足、I&2:経験不足、I&4:能力不足）
J = 0

CALL DECIDE_ABLUP21

;欲望が抖M气质＋１レベルでないといけない
PRINTFORML %ABLNAME:11%LV{ABL:21+1}以上(现在LV{ABL:11})且

;ＬＶ３から４、４から５に上げるときは异常经验必要（素質：[开放][倒錯的][受虐狂]なら無視できる）
SIF F > 0
	PRINTFORML %EXPNAME:50%{F}以上(现在{EXP:50})且

IF B > 0
	PRINTFORM [0] - %PALAMNAME:9%点数×{JUEL:9}/{A} ……
	PRINTV GET_ABLUP_STATE(I)
	PRINTL 
	;欲情点数
	PRINTFORML 　　　%PALAMNAME:5%点数×{JUEL:5}/{B}
	;被虐快乐经验
	SIF C > 0
		PRINTFORML 　　　%EXPNAME:30%　{EXP:30}/{C}
ENDIF

IF D > 0
	PRINTFORM [1] - %PALAMNAME:9%点数×{JUEL:9}/{D} ……
	PRINTV GET_ABLUP_STATE(J)
	PRINTL 
	;屈服点数
	PRINTFORML 　　　%PALAMNAME:6%点数×{JUEL:6}/{E}
	;被虐快乐经验
	SIF C > 0
		PRINTFORML 　　　%EXPNAME:30%　{EXP:30}/{C}
	;绝顶经验
	SIF G > 0
		PRINTFORML 　　　%EXPNAME:2%　{EXP:2}/{G}
ENDIF

PRINTL [100] - 停止

INPUT
IF (RESULT < 0 || RESULT > 1) && RESULT != 100
	RESTART
ELSEIF I != 0 && RESULT == 0
	PRINTL 未满足条件
	RESTART
ELSEIF J == 256 && RESULT == 1
	RESTART
ELSEIF J != 0 && RESULT == 1
	PRINTL 未满足条件
	RESTART
ELSEIF RESULT == 100
	RETURN 0
ENDIF

ABL:21 += 1

IF RESULT == 0
	JUEL:9 -= A
	JUEL:5 -= B
ELSEIF RESULT == 1
	JUEL:9 -= D
	JUEL:6 -= E
ENDIF

PRINTFORML %ABLNAME:21%变为LV{ABL:21}。

RETURN 0


;-------------------------------------------------
@CORE_ABLUP21
;-------------------------------------------------
ABL:21 ++

IF I == 0
	JUEL:9 -= A
	JUEL:5 -= B
ELSEIF J == 0
	JUEL:9 -= D
	JUEL:6 -= E
ENDIF


;-------------------------------------------------
;抖M气质のLvUP可否判定
;-------------------------------------------------
@DECIDE_ABLUP21
;[胆怯][文静][把柄][受虐狂]が付いている場合はLv10まで开放
SIF ABL:21 >= 5 && (TALENT:10 == 0 && TALENT:14 == 0 && TALENT:37 == 0 && TALENT:88 == 0)
	RETURN 0
;抖S气质＋抖M气质は21以上にならない
SIF ABL:20 + ABL:21 >= 20
	RETURN 0
;受虐狂ッ気はLv10が上限
SIF ABL:21 >= 10
	RETURN 0

;苦痛＋欲情で上げる場合に必要な苦痛点数
A = 0
;必要な欲情点数
B = 0
;必要な被虐快乐经验回数
C = 0
;苦痛＋屈服で上げる場合に必要な苦痛点数
D = 0
;必要な屈服点数
E = 0
;必要な异常经验回数
F = 0

;条件別にＯＫかダメかを記録する
;苦痛＋欲情点数による可否（I=0:可、I&1:点数不足、I&2:経験不足、I&4:能力不足）
I = 0
;苦痛＋屈服点数による可否（I=0:可、I&1:点数不足、I&2:経験不足、I&4:能力不足）
J = 0

IF ABL:21 == 0
	A = 100
	B = 100
	C = 0
	D = 100
	E = 100
ELSEIF ABL:21 == 1
	A = 500
	B = 500
	C = 0
	D = 500
	E = 300
ELSEIF ABL:21 == 2
	A = 1200
	B = 1000
	C = 0
	D = 1500
	E = 1000
ELSEIF ABL:21 == 3
	A = 0
	B = 0
	C = 30
	D = 2800
	E = 6000
ELSEIF ABL:21 == 4
	A = 0
	B = 0
	C = 80
	D = 4300
	E = 12000
ELSEIF ABL:21 == 5
	A = 0
	B = 0
	C = 150
	D = 6000
	E = 24000
ELSEIF ABL:21 == 6
	A = 0
	B = 0
	C = 200
	D = 8000
	E = 38000
ELSEIF ABL:21 == 7
	A = 0
	B = 0
	C = 300
	D = 11000
	E = 56000
ELSEIF ABL:21 == 8
	A = 0
	B = 0
	C = 450
	D = 15000
	E = 86000
ELSEIF ABL:21 == 9
	A = 0
	B = 0
	C = 600
	D = 20000
	E = 120000
ENDIF

;戒备森严
IF TALENT:27
	IF ABL:21 == 3
		TIMES C , 1.50
		TIMES D , 1.50
		TIMES E , 1.50
	ELSEIF ABL:21 == 4
		TIMES C , 2.00
		TIMES D , 2.00
		TIMES E , 2.00
	ELSEIF ABL:21 == 5
		TIMES C , 2.50
		TIMES D , 2.50
		TIMES E , 2.50
	ELSEIF ABL:21 >= 6
		TIMES C , 3.00
		TIMES D , 3.00
		TIMES E , 3.00
	ENDIF
ENDIF

;ＬＶ３から４、４から５、７から８に上げるときは异常经验必要（素質：[开放][倒錯的][受虐狂]なら無視できる）
SIF (ABL:21 == 3 || ABL:21 == 4 || ABL:21 == 7) && TALENT:33 == 0 && TALENT:80 == 0 && TALENT:88 == 0
	F = ABL:21 - 2

;必要な绝顶经验数は全レベル1
G = 1

;胆怯
IF TALENT:10
	TIMES A , 1.10
	TIMES B , 1.10
	TIMES C , 1.10
	TIMES D , 1.10
	TIMES E , 1.10
ENDIF
;反抗心
IF TALENT:11
	TIMES A , 1.20
	TIMES B , 1.20
	TIMES C , 1.20
	TIMES D , 1.20
	TIMES E , 1.20
ENDIF
;刚强
IF TALENT:12
	TIMES A , 1.20
	TIMES B , 1.20
	TIMES C , 1.20
	TIMES D , 1.20
	TIMES E , 1.20
ENDIF
;嚣张
IF TALENT:16
	TIMES A , 1.20
	TIMES B , 1.20
	TIMES C , 1.20
	TIMES D , 1.20
	TIMES E , 1.20
ENDIF

;高姿态
IF TALENT:15
	TIMES A , 1.20
	TIMES B , 1.20
	TIMES C , 1.20
	TIMES D , 1.20
	TIMES E , 1.20
;低姿态
ELSEIF TALENT:17
	TIMES A , 0.90
	TIMES B , 0.90
	TIMES C , 0.90
	TIMES D , 0.90
	TIMES E , 0.90
