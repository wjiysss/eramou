		CFLAG:(ARG:0):107 = LOVE_EXP:4
	CASE 41 TO 60
		;女性?ふたなり
		RACE = 4
		CFLAG:(ARG:0):105 = LOVE_EXP:4
	CASE 61 TO 80
		;少年
		RACE = 4
		CFLAG:(ARG:0):105 = LOVE_EXP:4
	CASE 81
		;犬
		RACE = 5
		CFLAG:(ARG:0):106 = LOVE_EXP:4
	CASE 82 TO 100
		;その他の獣
		RACE = 6
		CFLAG:(ARG:0):107 = LOVE_EXP:4
	ENDSELECT
	CALL NAKADASHI_CHECK , ARG:0 , RACE
ENDIF


IF MARRIAGE != 902
	PRINTW (善恶值减少:-1)
	CALL KARMA, ARG:0, -1
ELSE
	WAIT
ENDIF

CFLAG:(ARG:0):607 += 1

RETURN 1

