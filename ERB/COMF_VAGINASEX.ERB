@CONFIRM_LOST_VIRGIN
$INPUT_LOOP_01
IF TALENT:0
	PRINTFORML 夺取%SAVESTR:TARGET%的处女吗？
	PRINTL  [0] - 来吧女人
	PRINTL  [1] - 让她继续做女孩
	INPUT
	IF RESULT == 1
		RETURN 0
	ELSEIF RESULT != 0
		GOTO INPUT_LOOP_01
	ENDIF
ENDIF
RETURN 1

@CONFIRM_LOST_VIRGIN_YOU
