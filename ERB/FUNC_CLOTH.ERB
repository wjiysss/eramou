	PRINTFORML 《%SAVESTR:TARGET%的%GET_CLOTHTYPE_SPECIAL()%沾满了尿》
	TFLAG:45 |= 16
	;オムツ着用中なら他の衣類は無事
	SIF CFLAG:42 == 69
		RETURN 1
ENDIF
IF (CFLAG:40 & 8) || (CFLAG:40 & 16)
	PRINTFORM 《%SAVESTR:TARGET%正穿着
	CALL PRINT_CLOTHTYPE_MAIN2
