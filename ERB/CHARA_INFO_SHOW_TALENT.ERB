;==================================================	


@STC_PRINTC(ARGS, ARG = 15)
LOCAL = ARG - (STRLENS(ARGS) % ARG)
SIF LOCAL == ARG
	LOCAL = 0

PRINTS ARGS
PRINTS " " * LOCAL



; 绘制行头 素质ARG
@STC_LAB_TAL(ARG)	
IF TALENT:9
	; TALENT:9 【崩坏】
	CALL STC_COLOR_INVALID
ELSEIF TALENT:ARG
	CALL STC_COLOR_ACHIEVE
ELSE
	CALL STC_COLOR_DEFAULT
ENDIF
LOCALS = %TALENTNAME:ARG%
SIF ARG == 230 && TALENT:122
	LOCALS = 绝伦

SIF STRLENS(LOCALS) <= 4
	LOCALS = %LOCALS,4,LEFT%条件
PRINTFORM %LOCALS,8,LEFT%： 



; 能力ARG >= ARG:1 
@STC_SAY_ABL(ARG, ARG:1)
IF ABL:ARG >= ARG:1
	CALL STC_COLOR_TRUE
ELSE
	CALL STC_COLOR_FALSE
ENDIF
IF ARG == 0 && TALENT:122
	CALL STC_PRINTC(@"[阴茎感觉 Lv{ARG:1}]")
ELSE
	CALL STC_PRINTC(@"[%ABLNAME:ARG,6,LEFT% Lv{ARG:1}]")
ENDIF

; 能力ARG >= ARG:1 
;@STC_SAY_JUEL(ARG, ARG:1)
;IF JUEL:ARG >= ARG:1
;	CALL STC_COLOR_TRUE
;ELSE
;	CALL STC_COLOR_FALSE
;ENDIF
;IF ARG == 0 && TALENT:122
;	CALL STC_PRINTC(@"[阴茎点数 {ARG:1,4}]")
;ELSE
;	CALL STC_PRINTC(@"[%JUELNAME:ARG,6,LEFT% {ARG:1,4}]")
;ENDIF

; 经验ARG >= ARG:1 
@STC_SAY_EXP(ARG, ARG:1)
IF EXP:ARG >= ARG:1
	CALL STC_COLOR_TRUE
ELSE
	CALL STC_COLOR_FALSE
ENDIF
LOCALS = %EXPNAME:ARG%
SIF STRLENS(LOCALS) > 8
	LOCALS = %SUBSTRING(LOCALS,0,8)%
CALL STC_PRINTC(@"[%LOCALS,8,LEFT%{ARG:1,4}]")

; MARK:ARG >= ARG:1
@STC_SAY_MARK(ARG, ARG:1 = 0)
IF MARK:ARG >= ARG:1
	CALL STC_COLOR_TRUE
ELSE
	CALL STC_COLOR_FALSE
ENDIF
CALL STC_PRINTC(@"[%MARKNAME:ARG,6,LEFT% Lv{ARG:1}]")

; 素质ARG 有
@STC_SAY_TAL(ARG)
IF TALENT:ARG 
	CALL STC_COLOR_TRUE
ELSE
	CALL STC_COLOR_FALSE
ENDIF
LOCALS = %TALENTNAME:ARG%
SIF ARG == 230 && TALENT:122
	LOCALS = 绝伦
SIF STRLENS(LOCALS) <= 4
	LOCALS += "素质"
CALL STC_PRINTC(@"[%LOCALS%]",12)


; 印记ARG <= ARG:1
@STC_SAYNO_MARK(ARG, ARG:1 = 0)
IF MARK:ARG <= ARG:1
	CALL STC_COLOR_RIGHT
ELSE
	CALL STC_COLOR_ALERT
ENDIF
CALL STC_PRINTC(@"[%MARKNAME:ARG%]",12)
	
; 素质ARG <= ARG:1
@STC_SAYNO_TAL(ARG, ARG:1 = 0)
IF TALENT:ARG <= ARG:1
	CALL STC_COLOR_RIGHT
ELSE
	CALL STC_COLOR_ALERT
ENDIF
CALL STC_PRINTC(@"[%TALENTNAME:ARG%]",12)

	
; 经验ARG:1 + 经验ARG:2 + 经验ARG:3 >= ARG:0
@STC_SAYSUM_EXP(ARG, ARG:1, ARG:2 = 0, ARG:3 = 0)
LOCAL = 0

REPEAT 3
	SIF ARG:(COUNT+1) > 0
		LOCAL += EXP:(ARG:(COUNT+1))
REND

IF LOCAL >= ARG
	CALL STC_COLOR_TRUE
ELSE
	CALL STC_COLOR_FALSE
ENDIF
LOCALS = [
LOCALS += SUBSTRING(EXPNAME:(ARG:1),0,8)
REPEAT 2
	SIF ARG:(COUNT+2) > 0
		LOCALS += "|" + SUBSTRING(EXPNAME:(ARG:(COUNT+2)),0,8)
REND
PRINTFORM %LOCALS%{ARG,4}]


; ABL:C + ABL:B + ABL:V + ABL:A >= ARG
@STC_SAY_ABCV(ARG)
LOCAL = 0
REPEAT 4	
	LOCAL += ABL:COUNT
REND
IF LOCAL >= ARG
	CALL STC_COLOR_TRUE
ELSE
	CALL STC_COLOR_FALSE
ENDIF
CALL STC_PRINTC(@"[四点感觉Lv{ARG}]")

; 能力ARG:1 + ARG:2 + ARG:3 + ARG:4 >= ARG
@STC_SAYSUM_ABL(ARG, ARG:1, ARG:2 = 0, ARG:3 = 0, ARG:4 = 0)
LOCAL = 0
REPEAT 4
	SIF ARG:(COUNT+1) > 0
		LOCAL += ABL:(COUNT+1)
REND

IF LOCAL >= ARG
	CALL STC_COLOR_TRUE
ELSE
	CALL STC_COLOR_FALSE
ENDIF

PRINTFORM [%ABLNAME:(ARG:1)%
REPEAT 3
	SIF ARG:(COUNT+2) > 0
		PRINTFORM |%ABLNAME:(ARG:(COUNT+2))%
REND
PRINTFORM  Lv{ARG}]




