@QUEST_BITCH, ARG:0
#DIM LCOUNT
#DIM MONID
#DIM MONTYPE
#DIM MONNUM
#DIM MCOUNT
;---------------------------------

FOR MCOUNT, 0, 300, 100
	;一応モンスター数の確認
	MONNUM = E:(MCOUNT + 99)
	SIF MONNUM <= 0
