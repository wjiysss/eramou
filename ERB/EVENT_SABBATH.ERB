	RETURN 0

;陥落以外は除外
SIF CFLAG:0 == 0
	RETURN 0

;信仰値が40以上必要
SIF CFLAG:152 < 40
	RETURN 0

SABBATH_USER = RAND:4


PRINTL  
PRINTFORML %SAVESTR:TARGET%参与了献给无名的淫荡女神的仪式，

IF SABBATH_USER == 0 && ITEM:22
	;野良犬がいれば、獣姦儀式
	PRINTDATAW
