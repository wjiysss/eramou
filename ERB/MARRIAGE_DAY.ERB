;結婚生活の日常

;-----------------------------------
@MARRIAGE_DAY,ARG
#DIM MARRY_TYPE
#DIM MARRY_CHARA
#DIM NG_FLAG
;-----------------------------------
;ARGがキャラ

NG_FLAG = 0

;調教可以外はなし
SIF CFLAG:(ARG):1 != 0
	NG_FLAG = 1

MARRY_TYPE = CFLAG:(ARG):601

SIF MARRY_TYPE == 0
	NG_FLAG = 1

IF NG_FLAG > 0
	;恋人はここで
	SIF CFLAG:(ARG):606 == 0
		CALL DUNGEON_TOWN_LOVER_CHARA_ENTER,ARG:0
	SIF CFLAG:(ARG):606 == 200
		CALL DUNGEON_TOWN_LOVER,ARG
	RETURN 0
ENDIF

CFLAG:(ARG):602 += 1

;旦那がいない場合スキップ
IF MARRY_TYPE < 900 && CFLAG:(ARG):609 == 0
	X = MARRY_TYPE
	;暂时性灵魂转移修复
	;SIF ARG == 0 && MARRY_TYPE != 900 && MARRY_TYPE != 901 && MARRY_TYPE != 902 && CFLAG:(ARG):609 == 0
	;	RETURN 0
	SIF ITEM:X <= 0
		RETURN 0
ENDIF

PRINTL
DRAWLINE
PRINTFORM *%SAVESTR:ARG%和

IF MARRY_TYPE == 902
	;恋人
	LOCAL:2 = CFLAG:(ARG):606
	CALL NAME_LOVER,LOCAL:2,1
ELSEIF CFLAG:(ARG):609 > 0
	CALL SEARCH_FAMILY,ARG,"MARRIAGE"
	MARRY_CHARA = RESULT
	IF RESULT < 0
		PRINT 奴隶
	ELSE
		PRINTFORM %SAVESTR:MARRY_CHARA%
	ENDIF
ELSEIF MARRY_TYPE < 900
	CALL MONSTER_DATA, MARRY_TYPE, 5
	LOCAL:1 = E:507
	PRINTFORM %ITEMNAME:X%
ELSEIF MARRY_TYPE == 900
	PRINT 野狗
ELSEIF MARRY_TYPE == 901
	PRINT 你
ELSE
	LOCAL:1 = 0
	CALL SEARCH_FAMILY,ARG,"MARRIAGE"
	MARRY_CHARA = RESULT
	IF RESULT < 0
		PRINT 奴隶
	ELSE
		PRINTFORM %SAVESTR:MARRY_CHARA%
	ENDIF
ENDIF

PRINTFORMW 的结婚生活*

;妊娠・育児の場合
IF TALENT:(ARG):153
	PRINTW 夫妇俩人期待着孩子的出生。
	RETURN 0
ELSEIF TALENT:(ARG):154
	PRINTW 夫妇俩人期待着孩子的长大。
	RETURN 0
ENDIF

Y = RAND:5 + 1
CFLAG:(ARG):601 = MARRY_TYPE
CFLAG:(ARG):107 = 0
CFLAG:(ARG):112 = 0

IF MARRY_TYPE == 900
	CALL MARRIAGE_DAY_DOG,ARG
ELSEIF MARRY_TYPE == 901
	CALL MARRIAGE_DAY_YOU,ARG
ELSEIF MARRY_TYPE == 902
	CALL MARRIAGE_DAY_LOVERS,LOCAL:2,ARG
ELSEIF CFLAG:(ARG):609 > 0 && MARRY_CHARA > 0
	CALL MARRIAGE_DAY_SLAVE,ARG,MARRY_CHARA
ELSEIF LOCAL:1 == 1
	CALL ORC_MARRIAGE_DAY,ARG
ELSEIF LOCAL:1 == 2
	CALL SLIME_MARRIAGE_DAY,ARG
ELSEIF LOCAL:1 == 3
	CALL INSECT_MARRIAGE_DAY,ARG
ELSEIF LOCAL:1 == 4
	CALL IVY_MARRIAGE_DAY,ARG
ELSEIF LOCAL:1 == 5
	CALL SYOKUSYU_MARRIAGE_DAY,ARG
ELSEIF LOCAL:1 == 6
	CALL FAILY_MARRIAGE_DAY,ARG
ELSEIF LOCAL:1 == 7
	CALL GIANT_MARRIAGE_DAY,ARG
ELSEIF LOCAL:1 == 8
	CALL MAN_MARRIAGE_DAY,ARG
ELSEIF LOCAL:1 == 9
	CALL GIRL_MARRIAGE_DAY,ARG
ELSEIF LOCAL:1 == 10
	CALL BEAST_MARRIAGE_DAY,ARG
ELSEIF LOCAL:1 == 11
	CALL BRAIN_MARRIAGE_DAY,ARG
ELSEIF LOCAL:1 == 12
	CALL HORSE_MARRIAGE_DAY,ARG
ELSE
	CALL MARRIAGE_DAY_SLAVE,ARG,MARRY_CHARA
ENDIF

IF TALENT:A:0 == 1 && EXP:A:0 > 0 && TALENT:A:273 == 0 && CFLAG:A:42 != 79 && LOCAL:1 != 2 && LOCAL:1 != 3 && LOCAL:1 != 4
	PRINTW 【处女丧失】
	TALENT:(ARG):0 = 0
ENDIF

;異種妊娠フラグ
IF CFLAG:(ARG):107 != 0 && MARRY_TYPE != 900 && MARRY_TYPE != 901 && MARRY_TYPE != 902
	CFLAG:(ARG):112 = X
ENDIF

IF TALENT:A:130 == 1
PRINTFORMW %SAVESTR:A%多余的奶水被卖出了获得{Y * 100}pts

MONEY += Y * 100
EX_FLAG:4444 += Y * 100
ENDIF

