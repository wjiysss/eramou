;卖淫中毒のLvUP処理とその可否判定
;eraIm@s_ver.0.17βdのスクリプトをベースに処理を簡略化
;eraIM@Sから導入しました(eramaou)

;-------------------------------------------------
;卖淫中毒のLvUP
;-------------------------------------------------
@ABLUP37
DRAWLINE
;PRINTL 奴隶的卖淫成瘾加深了。
;PRINTL 卖淫中毒越高，越容易在卖淫中感到满足，
;PRINTL 不持续出卖自己的灵活及肉体的话，会让她感到不安。
;CUSTOMDRAWLINE ‥
;卖淫中毒はLv10が上限
;[淫乱][看轻贞操][妓女]が付いている場合はLv10まで开放
IF ABL:37 >= 5 && (TALENT:76 == 0 && TALENT:31 == 0 && TALENT:180 == 0)
	PRINTW 需要特殊素质才能继续提升
	RETURN 0
ELSEIF ABL:37 >= 10
	PRINTW 已达最高级
	RETURN 0
ENDIF

;必要な恭顺点数
A = 0
;必要な欲情点数
B = 0
;必要な屈服点数
C = 0
;必要な卖淫经验
D = 0
;必要な异常经验回数
F = 0

;条件別にＯＫかダメかを記録する
I = 0

CALL DECIDE_ABLUP37

;ＬＶ２から３、ＬＶ３から４、４から５に上げるときは异常经验必要
;(素質：[开放][接受快感][容易陷落][淫乱][倒錯的][容易上瘾][妓女][倾城]があると緩和、
;[反抗心][克制][压抑][抵抗][否定快感][恋慕][親爱][相爱][求爱]があると増加、[疯狂][服従][隷属][使い魔]なら無視できる)
SIF F > 0
	PRINTFORML %EXPNAME:50%{F}以上(现在{EXP:50})且

;欲望が必要
PRINTFORML %ABLNAME:11%LV{ABL:37 + 1}以上(现在LV{ABL:11})且

PRINTFORM [0] - %PALAMNAME:4%点数×{JUEL:4}/{A} ……
PRINTV GET_ABLUP_STATE(I)
PRINTL 
PRINTFORML 　　　%PALAMNAME:5%点数×{JUEL:5}/{B}
PRINTFORML 　　　%PALAMNAME:6%点数×{JUEL:6}/{C}
PRINTFORML 　　　%EXPNAME:74%　{EXP:74}/{D}
PRINTL [100] - 停止

INPUT
IF RESULT != 0 && RESULT != 100
	RESTART
ELSEIF I != 0 && RESULT == 0
	PRINTL 未满足条件
	RESTART
ELSEIF RESULT == 100
	RETURN 0
ENDIF

ABL:37 += 1
IF RESULT == 0
	JUEL:4 -= A
	JUEL:5 -= B
	JUEL:6 -= C
ENDIF

PRINTFORML %ABLNAME:37%变为LV{ABL:37}。

RETURN 0


;-------------------------------------------------
@CORE_ABLUP37
;-------------------------------------------------
ABL:37 ++

IF I == 0
	JUEL:4 -= A
	JUEL:5 -= B
	JUEL:6 -= C
ENDIF


;-------------------------------------------------
;卖淫中毒のLvUP可否判定
;-------------------------------------------------
@DECIDE_ABLUP37
SIF ABL:37 + ABL:38 >= 10
	RETURN 0
SIF ABL:37 >= 5 && (TALENT:76 == 0 && TALENT:31 == 0 && TALENT:180 == 0)
	RETURN 0

;判定変数を空に
I = 0

A = 0
B = 0
C = 0
D = 0
F = 0

IF ABL:37 == 0
	A = 2000
	B = 3000
	C = 1000
	D = 50
ELSEIF ABL:37 == 1
	A = 5000
	B = 8000
	C = 2500
	D = 100
ELSEIF ABL:37 == 2
	A = 8000
	B = 15000
	C = 5500
	D = 150
ELSEIF ABL:37 == 3
	A = 14000
	B = 30000
	C = 10000
	D = 250
ELSEIF ABL:37 == 4
	A = 22000
	B = 50000
	C = 20000
	D = 400
ELSEIF ABL:37 == 5
	A = 34000
	B = 80000
	C = 30000
	D = 500
ELSEIF ABL:37 == 6
	A = 55000
	B = 120000
	C = 50000
	D = 800
ELSEIF ABL:37 == 7
	A = 80000
	B = 180000
	C = 60000
	D = 1200
ELSEIF ABL:37 == 8
	A = 150000
	B = 300000
	C = 90000
	D = 2000
ELSEIF ABL:37 == 9
	A = 300000
	B = 600000
	C = 150000
	D = 3000
ENDIF

;戒备森严
IF TALENT:27
	IF ABL:37 == 3
		TIMES A , 1.50
		TIMES B , 1.50
		TIMES C , 1.50
		TIMES D , 1.50
	ELSEIF ABL:37 == 4
		TIMES A , 2.00
		TIMES B , 2.00
		TIMES C , 2.00
		TIMES D , 2.00
	ELSEIF ABL:37 == 5
		TIMES A , 2.50
		TIMES B , 2.50
		TIMES C , 2.50
		TIMES D , 2.50
	ELSEIF ABL:37 >= 6
		TIMES A , 3.00
		TIMES B , 3.00
		TIMES C , 3.00
		TIMES D , 3.00
	ENDIF
ENDIF

;反抗心
IF TALENT:11
	TIMES A , 1.50
	TIMES B , 1.50
	TIMES C , 1.50
	TIMES D , 1.50
ENDIF
;刚强
IF TALENT:12
	TIMES A , 1.20
	TIMES B , 1.20
	TIMES C , 1.20
	TIMES D , 1.20
ENDIF
;克制
IF TALENT:20
	TIMES A , 1.50
	TIMES B , 1.50
	TIMES C , 1.50
	TIMES D , 1.50
ENDIF
;保守的
IF TALENT:24
	TIMES A , 1.50
	TIMES B , 1.50
	TIMES C , 1.50
	TIMES D , 1.50
ENDIF

;悲观的
IF TALENT:26
	TIMES A , 0.90
	TIMES B , 0.90
	TIMES C , 0.90
	TIMES D , 0.90
ENDIF
;爱表现
IF TALENT:28
	TIMES A , 0.90
	TIMES B , 0.90
	TIMES C , 0.90
	TIMES D , 0.90
ENDIF

;看重贞操
IF TALENT:30
	TIMES A , 2.00
	TIMES B , 2.00
	TIMES C , 2.00
	TIMES D , 2.00
;看轻贞操
ELSEIF TALENT:31
	TIMES A , 0.90
	TIMES B , 0.90
	TIMES C , 0.90
	TIMES D , 0.90
ENDIF

;压抑
IF TALENT:32
	TIMES A , 1.20
	TIMES B , 1.20
	TIMES C , 1.20
	TIMES D , 1.20
;开放
ELSEIF TALENT:33
	TIMES A , 0.80
	TIMES B , 0.80
	TIMES C , 0.80
	TIMES D , 0.80
ENDIF

;抵抗
IF TALENT:34
	TIMES A , 2.00
	TIMES B , 2.00
	TIMES C , 2.00
	TIMES D , 2.00
ENDIF

;害羞
IF TALENT:35
	TIMES A , 1.10
	TIMES B , 1.10
	TIMES C , 1.10
	TIMES D , 1.10
;不知羞耻
ELSEIF TALENT:36
	TIMES A , 0.90
	TIMES B , 0.90
	TIMES C , 0.90
	TIMES D , 0.90
ENDIF
;献身的
IF TALENT:63
	TIMES A , 0.90
	TIMES B , 0.90
	TIMES C , 0.90
	TIMES D , 0.90
ENDIF
;容易上瘾
IF TALENT:72
	TIMES A , 0.50
	TIMES B , 0.50
	TIMES C , 0.50
	TIMES D , 0.50
ENDIF
;淫乱
IF TALENT:76
	TIMES A , 0.80
	TIMES B , 0.50
	TIMES C , 0.80
	TIMES D , 0.80
ENDIF
;讨厌男人
IF TALENT:82
	TIMES A , 3.00
	TIMES B , 3.00
	TIMES C , 3.00
	TIMES D , 3.00
ENDIF
;爱慕
IF TALENT:85
	TIMES A , 1.50
	TIMES B , 1.50
	TIMES C , 1.50
	TIMES D , 1.50
ENDIF
;妊娠
IF TALENT:153
	TIMES A , 2.00
	TIMES B , 2.00
	TIMES C , 2.00
	TIMES D , 2.00
ENDIF
;疯狂
IF TALENT:123
	TIMES A , 0.50
	TIMES B , 0.50
	TIMES C , 0.50
	TIMES D , 0.50
ENDIF
;崩坏
IF TALENT:9
	TIMES A , 0.80
	TIMES B , 0.80
	TIMES C , 0.80
	TIMES D , 0.80
ENDIF
;妓女
IF TALENT:180
	TIMES A , 0.80
	TIMES B , 0.80
	TIMES C , 0.80
	TIMES D , 0.80
ENDIF
;倾城
IF TALENT:181
	TIMES A , 0.50
	TIMES B , 0.50
	TIMES C , 0.50
	TIMES D , 0.50
ENDIF
;有常客
IF TALENT:183
	TIMES A , 0.90
	TIMES B , 0.90
	TIMES C , 0.90
	TIMES D , 0.90
ENDIF
;求爱
IF TALENT:184
	TIMES A , 2.00
	TIMES B , 2.00
	TIMES C , 2.00
	TIMES D , 2.00
ENDIF


;ＬＶ２から３、ＬＶ３から４、４から５に上げるときは异常经验必要
;(素質：[开放][接受快感][容易陷落][淫乱][倒錯的][容易上瘾][妓女][倾城]があると緩和、
;[反抗心][克制][压抑][抵抗][否定快感][爱慕][求爱]があると増加、[疯狂][崩坏]なら無視できる)
IF ABL:37 >= 2 && (TALENT:123 == 0 && TALENT:9 == 0)
	F = ABL:37 - 1
	SIF TALENT:33
		F -= 1
	SIF TALENT:70
		F -= 1
	SIF TALENT:72
		F -= 2
	SIF TALENT:73
		F -= 1
	SIF TALENT:76
		F -= 1
	SIF TALENT:80
		F -= 1
	SIF TALENT:180
		F -= 1
	SIF TALENT:181
		F -= 2
	SIF TALENT:11
		F += 1
	SIF TALENT:20
		F += 1
	SIF TALENT:32
		F += 1
	SIF TALENT:34
		F += 1
	SIF TALENT:71
		F += 1
	SIF TALENT:85
		F += 1
	SIF TALENT:184
		F += 2
	
	SIF F < 0
		F = 0
	IF EXP:50 < F
		;异常经验が不足
		I |= 2
		J |= 2
	ENDIF
ENDIF

;最低でも1回・1個は必要
SIF A < 1
	A = 1
SIF B < 1
	B = 1
SIF C < 1
	C = 1
SIF D < 1
	D = 1

;欲望が必要
IF ABL:11 < ABL:37 + 1
	I |= 4
	J |= 4
ENDIF

;恭顺点数は足りている？
SIF JUEL:4 < A
	I |= 1
;欲情点数は足りている？
SIF JUEL:5 < B
	I |= 1
;屈服点数は足りている？
SIF JUEL:6 < C
	I |= 1
;卖淫经验が必要
SIF EXP:74 < D
	I |= 2

IF I == 0
	RETURN 1
ELSE
	RETURN 0
ENDIF
