	PRINTFORMW 无论自慰了多少次，也无法填满对兽交的欲望。
ENDIF

RETURN 1

;-------------------------------------------------
;兽奸中毒による兽奸チェック
;-------------------------------------------------
@AFTERTRAIN_BEASTSEX_CHECK
;調教対象が空だとダメ
SIF TARGET < 0
	RETURN 0
;未熟だとダメ
SIF TALENT:135
	RETURN 0
;兽奸经验が50以上ないとダメ
SIF EXP:56 < 50
	RETURN 0
;处女や男人だとダメ
SIF TALENT:0 || TALENT:122 == 1
	RETURN 0
;貞操帯だとダメ
SIF CFLAG:42 == 79 && (CFLAG:40 & 64)
	RETURN 0
;貞操封印だとダメ
SIF CFLAG:273
	RETURN 0
;ITEM:野狗がないとダメ
SIF ITEM:22 == 0
	RETURN 0
;瀕死だとダメ
SIF BASE:0 < 500
	RETURN 0

B = 0

;兽奸中毒
IF ABL:39 == 0
	B -= 2
ELSEIF ABL:39 == 1
	B -= 1
ELSEIF ABL:39 == 2
	B += 0
ELSEIF ABL:39 == 3
	B += 1
ELSEIF ABL:39 == 4
	B += 2
ELSEIF ABL:39 == 5
	B += 3
ELSEIF ABL:39 >= 6
	B += 4
ENDIF

;动物耳朵で欲望ＬＶ３以上PALAM:欲情がLV3以上
SIF TALENT:124 && ABL:11 >= 3 && PALAM:5 >= PALAMLV:3
	B += 1

;PALAM:欲情がLV4以上
;欲望ＬＶ５以上露出癖４以上で+1（下と合わせて+2）
SIF ABL:11 >= 5 && ABL:17 >= 4 && PALAM:5 >= PALAMLV:4
	B += 1
;欲望ＬＶ４以上露出癖３以上で+1
SIF ABL:11 >= 4 && ABL:17 >= 3 && PALAM:5 >= PALAMLV:4
	B += 1

;牝犬によるボーナス
SIF TALENT:136
	B += 2

;回数が0以下なら終了
SIF B <= 0
	RETURN 0

;低姿态、开放、动物耳朵によるボーナス
SIF TALENT:17
	B += 1
SIF TALENT:33
	B += 1
SIF TALENT:124
	B += 1

;高姿态、克制、压抑、反感污臭によるペナルティ
SIF TALENT:15
	B -= 1
SIF TALENT:20
	B -= 1
SIF TALENT:32
	B -= 1
SIF TALENT:62 && TALENT:64 == 0
	B -= 2

;接受快感、否定快感
IF TALENT:70
	B += 1
ELSEIF TALENT:71
	B -= 2
ENDIF

;淫乱によるボーナス
SIF TALENT:76
	B += 1

;牝犬によるボーナスその２
SIF TALENT:136
	TIMES B , 1.50

;回数が0以下になっていたら終了
SIF B <= 0
	RETURN 0

DRAWLINE
PRINTFORM 之后，%SAVESTR:TARGET%悄悄地去了饲养狗的狗舍，
PRINTFORML 进行了{B}次交配。

;兽奸经验
PRINTFORML %EXPNAME:56%＋{B}
PRINTFORML %EXPNAME:0%＋{B}
PRINTFORML %EXPNAME:5%＋{B}
EXP:56 += B
EXP:0 += B
EXP:5 += B

;珠経験
PRINTFORML %PALAMNAME:1%点数＋{B*200}
PRINTFORML %PALAMNAME:6%点数＋{B*300}
PRINTFORMW %PALAMNAME:8%点数＋{B*200}
JUEL:1 += B*200
JUEL:6 += B*300
JUEL:8 += B*200

;顺从+露出+抖M气质が12以上かつ時間が朝なら主人に報告
IF ABL:10+ABL:17+ABL:21 >= 12 && TIME == 0
	PRINTFORM 在那之后%SAVESTR:TARGET%
	SIF TALENT:124
		PRINT 摇着尾巴，
	PRINTFORML 来报告了。
	PRINTFORML %PALAMNAME:8%点数＋{B*200}
	JUEL:8 += A*200
ENDIF



RETURN 1
