;-----------------------------------
@MONSTER_PLAY
;-----------------------------------
DRAWLINE
PRINTL 请选择怪物
DRAWLINE
CALL MONSTERPLAY_LIST

SIF ITEM:22 >= 1
	PRINT [900] 野狗
PRINTL [999] 返回

$INPUT_LOOP
INPUT

IF RESULT == 999
	RETURN 0
ELSEIF ITEM:RESULT <= 0 && RESULT != 900
	CLEARLINE 1
	GOTO INPUT_LOOP
ELSEIF RESULT == 900 && ITEM:22 <= 0
	CLEARLINE 1
	GOTO INPUT_LOOP
ENDIF

LOCAL:0 = RESULT
IF LOCAL:0 != 900
	CALL MONSTER_DATA, LOCAL:0, 5
	LOCAL:1 = E:507
ENDIF

A = 0
Y = RAND:5 + 3

IF LOCAL:0 == 900
	CALL MONSTER_PLAY_DOG
ELSEIF LOCAL:1 == 1
	CALL ORC_MONSTER_PLAY
ELSEIF LOCAL:1 == 2
	CALL SLIME_MONSTER_PLAY
ELSEIF LOCAL:1 == 3
	CALL INSECT_MONSTER_PLAY
ELSEIF LOCAL:1 == 4
	CALL IVY_MONSTER_PLAY
ELSEIF LOCAL:1 == 5
	CALL SYOKUSYU_MONSTER_PLAY
ELSEIF LOCAL:1 == 6
	CALL FAILY_MONSTER_PLAY
ELSEIF LOCAL:1 == 7
	CALL GIANT_MONSTER_PLAY
ELSEIF LOCAL:1 == 8
	CALL MAN_MONSTER_PLAY
ELSEIF LOCAL:1 == 9
	CALL GIRL_MONSTER_PLAY
ELSEIF LOCAL:1 == 10
	CALL BEAST_MONSTER_PLAY
ELSEIF LOCAL:1 == 11
	CALL BRAIN_MONSTER_PLAY
ELSEIF LOCAL:1 == 12
	CALL HORSE_MONSTER_PLAY
ENDIF

IF TALENT:A:0 == 1 && EXP:A:0 > 0
	PRINTW 【处女丧失】
	TALENT:A:0 = 0
ENDIF



BEGIN TURNEND
RETURN 1

;-------------------------------------
@MONSTERPLAY_LIST
;-------------------------------------

LOCAL:1 = 0
FOR LOCAL:0, 100, 200
	IF ITEM:(LOCAL:0) >= 1
		PRINTFORM [{LOCAL:0}] %ITEMNAME:(LOCAL:0), 12, LEFT%
		LOCAL:1 += 1
	ENDIF
	
	IF LOCAL:1 >= 3
		PRINTL  
		LOCAL:1 = 0
	ENDIF
NEXT

SIF LOCAL:1 != 0
	PRINTL  

RETURN 0

