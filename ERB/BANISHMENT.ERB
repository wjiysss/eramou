		PRINTFORML 被放逐的%SAVESTR:A%又回到了之前的奴隶生涯。
		MATURO += "奴隶"
	CASE 21
		;主婦
		IF EXP:A:56 >= 5
			;獣姦経験5以上
			PRINTFORM %SAVESTR:A%最近新买了一只宠物犬。只是每次%SAVESTR:A%看着狗狗的眼神中总是充满了情欲。
			MATURO += "爱好兽奸的"
		ENDIF
		PRINTFORML 面对自己过往，毫不知情的丈夫，%SAVESTR:A%又回到了之前平静的主妇生活。
		MATURO += "主妇"
	CASEELSE
		PRINTFORMW 在此之后，%SAVESTR:A%下落不明了……
		MATURO = 下落不明
	ENDSELECT
	
	PRINTFORMW ——下场：%MATURO%
	
ENDIF

SIF FAMILY:2 >= 0
	CSTR:(FAMILY:2):5 = %MATURO%%SAVESTR:A%
TSTR:30 = %MATURO%%SAVESTR:A%
CALL VIDEO_MATURO
	
A = TARGET

;武器解除
W:0 = CFLAG:A:550
CALL EQUIP_GET
CFLAG:A:550 = -1
;指輪解除
W:0 = CFLAG:A:551
CALL EQUIP_GET
CFLAG:A:551 = -1
;指輪解除
W:0 = CFLAG:A:552
CALL EQUIP_GET
CFLAG:A:552 = -1

LV = CFLAG:A:9

X = NO:A + 199
FLAG:X = 1

;前回の助手?調教対象だった場合はフラグを空に
SIF FLAG:1 == TARGET
	FLAG:1 = -1
SIF FLAG:2 == TARGET
	FLAG:2 = -1

;前回の助手?調教対象より前だった場合はフラグを減算
SIF FLAG:1 > TARGET
	FLAG:1 -= 1
SIF FLAG:2 > TARGET
	FLAG:2 -= 1

TARGET = FLAG:1
ASSI = FLAG:2

CALL PARTY_CHAR_DEL, A

DELCHARA A

CALL NAME_RESET


FLAG:80 += 1

LV += 1
LV *= 50

EXP:0:80 += LV
PRINTFORMW 《你抽取了被封印的勇者之力尽为己用，获得了{LV}经验值》

TARGET = -1
RETURN 0
