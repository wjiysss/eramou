		PRINTS "\n"*2 + " [2] 变更难度倍数    "
		PRINTS "\n"*2 + " [0] 不做改变    "
		INPUT 
		IF RESULT == 1
			theFourHorsemenClearRounds += 1
			PRINTS "\n"*2 + " *** 四骑士堡垒可以重新攻略了 *** "
			WAIT
			PRINTS "\n"*2
			DRAWLINEFORM =
			PRINTS "\n"*8
			FLAG:92 = 0 
			RESTART 
