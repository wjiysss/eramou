	ENDIF
	
ELSEIF RAND:10 == 0 && CFLAG:ARG:582 < (LOCAL * -1) && MONEY >= LOCAL
;借金がLOCAL以上あり、あなたがLOCAL以上のお金を持ち、1/10の確率
	PRINTFORML *你可以拿{LOCAL}点，来帮%SAVESTR:ARG%还债*
	
	CALL SELECT_YES_NO
	
	IF RESULT == 0
