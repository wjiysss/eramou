# eraMaouEx LLM 模式配置
# 复制本文件为 .env 并填入真实密钥（.env 已被 .gitignore 排除，不会入库）

# 必填：LLM API 密钥
ERAMOU_LLM_API_KEY=your_api_key_here

# 可选：API 端点（默认值如下）
ERAMOU_LLM_BASE_URL=https://opencode.ai/zen/go/v1/chat/completions

# 可选：模型名（默认值如下）
ERAMOU_LLM_MODEL=deepseek-v4-flash

# ===== RAG 检索（embedding）配置 =====
# 可选：留空则禁用 RAG（游戏仍可正常运行，仅不注入相关知识检索）
ERAMOU_EMB_API_KEY=your_embedding_api_key_here

# 可选：embedding 端点（OpenAI 兼容 /v1/embeddings）
ERAMOU_EMB_BASE_URL=https://router.tumuer.me/v1/embeddings

# 可选：embedding 模型
ERAMOU_EMB_MODEL=Qwen/Qwen3-Embedding-4B
